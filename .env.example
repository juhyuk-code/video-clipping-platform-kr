# Database (Supabase Session Pooler)
DATABASE_URL="postgresql://clipplatform:clipplatform_dev@localhost:5432/clipplatform"

# Direct connection (bypasses pooler — needed for prisma db push/migrate)
# Get this from Supabase Dashboard → Settings → Database → Connection string → URI (Direct)
DIRECT_URL=""

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Kakao OAuth (https://developers.kakao.com)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Naver OAuth (https://developers.naver.com)
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Toss Payments (https://developers.tosspayments.com)
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# AWS S3
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_RAW="clipplatform-raw-uploads-kr"
S3_BUCKET_CLIPS="clipplatform-clips-kr"

# CloudFront
CLOUDFRONT_DOMAIN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
